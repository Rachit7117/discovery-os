# ── AI Provider ───────────────────────────────────────────────────────────────
# Which provider to use: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Model override — defaults to gemini-2.0-flash (gemini) or gpt-4o-mini (openai)
# AI_MODEL=gemini-2.0-flash

# ── API Keys ──────────────────────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI Platform → https://platform.openai.com/api-keys  (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=
